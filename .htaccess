# start.munas.online (Plesk/Apache). Vite copies this file into dist/.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Hashed build assets never change: cache for a year.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # index.html is always revalidated so a new release shows up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Logos and icons rarely change: let browsers keep them for a week.
  <FilesMatch "\.(png|svg|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Compress text responses (less traffic; harmless if nginx in front already does it).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Hide dotfiles, but keep /.well-known for Let's Encrypt.
RedirectMatch 404 "/\.(?!well-known)"

# BEGIN pre-launch (SITE_NOINDEX=1) – generated by vite.config.js, gone with SITE_NOINDEX=0
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/robots\.txt$
  RewriteCond %{HTTP_USER_AGENT} (bot|crawl|spider|slurp|facebookexternalhit|meta-externalagent|Bytespider|CCBot|ClaudeBot|Claude-Web|anthropic-ai|GPTBot|ChatGPT-User|OAI-SearchBot|PerplexityBot|Amazonbot|Applebot|Diffbot|ImagesiftBot|Omgili|DataForSeo|serpstat|Barkrowler|MJ12bot|AhrefsBot|SemrushBot|DotBot|PetalBot|YandexBot|BLEXBot) [NC]
  RewriteRule ^ - [F,L]
</IfModule>
# END pre-launch
